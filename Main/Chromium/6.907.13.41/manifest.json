{
  "manifest_version": 3,
  "name": "Nano EVO",
  "version": "6.907.13.41",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "sidePanel", 
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://generativelanguage.googleapis.com/*",
    "<all_urls>" 
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Nano EVO" },
  "side_panel": { "default_path": "sidepanel.html" },
  "web_accessible_resources": [
    {      "resources": ["dict/*", "kuromoji.js", "pdf.worker.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}